<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.towermarsh</groupId>
    <artifactId>opendata-parent</artifactId>
    <version>3.1.0</version>
    <packaging>pom</packaging>

    <name>OpenData Main</name>
    <description>Parent and build aggregator for the OpenData modules.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>24</maven.compiler.release>
        <junit.version>6.1.3</junit.version>
        <mockito.version>5.23.0</mockito.version>
        <checkstyle.version>10.26.1</checkstyle.version>
        <maven.resources.plugin.version>3.5.0</maven.resources.plugin.version>
        <maven.jar.plugin.version>3.5.1</maven.jar.plugin.version>
        <maven.compiler.plugin.version>3.15.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.6</maven.surefire.plugin.version>
        <maven.checkstyle.plugin.version>3.6.0</maven.checkstyle.plugin.version>
        <spotbugs.plugin.version>4.10.4.0</spotbugs.plugin.version>
        <javadoc.plugin.version>3.12.0</javadoc.plugin.version>
        <maven.enforcer.plugin.version>3.6.3</maven.enforcer.plugin.version>
        <jacoco.plugin.version>0.8.15</jacoco.plugin.version>
        <dependency.plugin.version>3.11.0</dependency.plugin.version>
        <quality.failOnViolation>false</quality.failOnViolation>
    </properties>

    <modules>
        <module>opendata-api</module>
        <module>opendata-common</module>
        <module>opendata-core</module>
    </modules>
</project>
