@startuml
title Ofgem price-cap import
actor Operator
participant Main
participant "Plugin orchestration" as plugin
participant "HTML link discoverer" as discovery
participant "HTTP downloader" as download
participant "Ingestion audit repository" as audit
participant "Ofgem workbook extractor" as extract
participant "Ofgem import service" as service
participant "Ofgem repository" as repo
database "OpenData SQL Server" as db

Operator -> Main : --plugin ofgem
Main -> plugin : execute(config)
plugin -> audit : startRun()
audit -> db : INSERT core.ingestion_run
plugin -> discovery : discover and select workbook
discovery --> plugin : source URI
plugin -> download : stream to staging
plugin -> audit : record source file + SHA-256
audit -> db : INSERT core.source_file
plugin -> extract : extract(workbook)
extract --> plugin : period + typed levels
plugin -> service : importWorkbook(...)
service -> repo : upsertPeriod(...)
repo -> db : transactional period upsert
service -> repo : replaceLevels(...)
repo -> db : BEGIN; DELETE; batch INSERT; COMMIT
repo --> service : written count
service --> plugin : OfgemImportResult
plugin -> audit : complete run
 audit -> db : UPDATE status/counters/finish
plugin --> Main : run result
Main --> Operator : status, duration, exit code
@enduml
