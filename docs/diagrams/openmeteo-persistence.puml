@startuml
skinparam monochrome true
participant OpenMeteoPlugin
participant OpenMeteoApiClient
participant OpenMeteoRepository
database SQLServer

OpenMeteoPlugin -> OpenMeteoApiClient : download(date range)
OpenMeteoApiClient --> OpenMeteoPlugin : List<DailyWeatherRecord>
OpenMeteoPlugin -> OpenMeteoRepository : save(records, runId)
OpenMeteoRepository -> SQLServer : BEGIN TRANSACTION
OpenMeteoRepository -> SQLServer : sp_getapplock(location key)
OpenMeteoRepository -> SQLServer : upsert Location
OpenMeteoRepository -> SQLServer : create/populate #OpenMeteoDaily
OpenMeteoRepository -> SQLServer : update changed rows
OpenMeteoRepository -> SQLServer : insert missing rows
OpenMeteoRepository -> SQLServer : COMMIT data transaction
OpenMeteoRepository -> SQLServer : DROP #OpenMeteoDaily / restore SET state
OpenMeteoRepository -> SQLServer : COMMIT session cleanup
OpenMeteoRepository --> OpenMeteoPlugin : inserted/updated/skipped
@enduml
