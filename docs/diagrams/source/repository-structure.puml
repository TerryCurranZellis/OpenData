@startuml
!pragma layout smetana
title OpenData Repository Structure
skinparam shadowing false
skinparam packageStyle rectangle

folder "OpenData" {
  folder "opendata-api\n(contracts, PluginRegistrar)" as Api
  folder "opendata-common\n(JDBC, SQL script runner)" as Common
  folder "opendata-core" {
    folder "main/java\n(app, gui, plugin.<id>)" as MainJava
    folder "main/resources/config/plugins\n(definitions + index)" as Resources
    folder "main/resources/sql/plugins\n(per-plugin schema SQL)" as PluginSql
    folder "test/java" as Tests
  }
  folder "sql" as Sql
  folder "docs" {
    folder "architecture / guides / plugins" as Markdown
    folder "diagrams/source" as Puml
    folder "diagrams/generated" as Svg
    folder "manifests" as Manifests
  }
  folder "config" as Config
  folder "scripts" as Scripts
  folder ".github" as Github
  folder "tools" as Tools
}

Api --> Common
Common --> MainJava
Api --> MainJava
MainJava --> Tests : verified by
PluginSql --> MainJava : run by each RegisterPlugin
Resources --> MainJava : bootstrap and registration definitions
Sql --> MainJava : database contract
Puml --> Svg : rendered
Markdown --> Manifests : composed by
Manifests --> Scripts : existing documentation engine
Config --> Scripts
Github --> Scripts
Tools --> Scripts
@enduml
