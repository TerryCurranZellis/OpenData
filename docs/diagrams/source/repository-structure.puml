@startuml
!pragma layout smetana
title OpenData Repository Structure
skinparam shadowing false
skinparam packageStyle rectangle

folder "OpenData" {
  folder "opendata-api\n(contracts, PluginRegistrar)" as Api
  folder "opendata-common\n(JDBC, SQL script runner)" as Common
  folder "opendata-core\n(runtime, GUI/CLI, registry)" as Core
  folder "opendata-plugins" {
    folder "opendata-plugin-<id>\n(provider code + tests)" as ProviderProjects
    folder "provider resources\n(definition + index + SQL)" as Resources
    folder "shared provider support" as ProviderSupport
    folder "test/java" as Tests
  }
  folder "sql" as Sql
  folder "docs" {
    folder "architecture / guides / plugins" as Markdown
    folder "diagrams/source" as Puml
    folder "diagrams/generated" as Svg
    folder "manifests" as Manifests
  }
  folder "config" as Config
  folder "scripts" as Scripts
  folder ".github" as Github
  folder "tools" as Tools
}

Api --> Common
Common --> Core
Api --> Core
ProviderProjects --> Core : runtime dependencies
ProviderSupport --> ProviderProjects
ProviderProjects --> Tests : verified by
Resources --> Core : classpath catalogue and registration definitions
Sql --> Core : database contract
Puml --> Svg : rendered
Markdown --> Manifests : composed by
Manifests --> Scripts : existing documentation engine
Config --> Scripts
Github --> Scripts
Tools --> Scripts
@enduml
