@startuml
!pragma layout smetana
title Shared Validation and Database Persistence Components
skinparam componentStyle rectangle
skinparam packageStyle rectangle

package "Configuration" {
  [PluginDefinition] as Definition
  [Shared validation\nPluginPropertyValues\nValidationRules\nSqlIdentifiers] as Validation
  [Typed plugin configuration\nOfgemConfiguration\nOpenMeteoConfiguration\nOctopusConfiguration] as PluginConfiguration
}

package "Plugin-owned persistence" {
  [Provider repositories\nOfgem period replacement\nOpenMeteo staged set-based load\nOctopus statement transaction] as Repositories
  [Typed Octopus adapters\nElectricityRecordUpsertAdapter\nGasRecordUpsertAdapter] as Adapters
}

package "Shared JDBC execution" {
  [Transaction and cleanup\nJdbcTransactionTemplate\nJdbcConnectionCleanup] as Transactions
  [Batch execution\nJdbcBatchExecutor\nJdbcStatementBinder] as Batches
  [Typed upsert flow\nJdbcUpsertExecutor\nJdbcUpsertAdapter\nJdbcUpsertResult] as Upserts
}

package "Database access" {
  interface DatabaseResourceManager
  [SQLServerResource and DBCP pool] as Resource
}

database "OpenData SQL Server" as Database

Definition --> Validation
Validation --> PluginConfiguration
PluginConfiguration --> Repositories
Repositories --> Transactions
Repositories --> Batches
Repositories --> Upserts
Repositories --> Adapters
Adapters ..> Upserts
Transactions --> DatabaseResourceManager
Batches --> DatabaseResourceManager
Upserts --> DatabaseResourceManager
Resource ..|> DatabaseResourceManager
Resource --> Database
@enduml
