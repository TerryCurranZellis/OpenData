@startuml
!pragma layout smetana
title Database Persistence Components
skinparam componentStyle rectangle

package "Runtime audit" {
  [JdbcPluginRunAudit] as PluginAudit
}

package "Ofgem" {
  [OfgemPlugin] as OfgemPlugin
  [load.OfgemPersistenceRepository] as OfgemRepository
}

package "OpenMeteo" {
  [OpenMeteoPlugin] as MeteoPlugin
  [load.OpenMeteoRepository] as MeteoRepository
}

package "Database access" {
  interface DatabaseResourceManager
  [SQLServerResource] as Resource
  [DBCP PoolingDriver] as Driver
  [GenericObjectPool] as Pool
}

database "OpenData SQL Server" as Database

OfgemPlugin --> OfgemRepository
MeteoPlugin --> MeteoRepository
PluginAudit --> DatabaseResourceManager
OfgemRepository --> DatabaseResourceManager
MeteoRepository --> DatabaseResourceManager
Resource ..|> DatabaseResourceManager
Resource --> Driver
Driver --> Pool
Pool --> Database
@enduml
