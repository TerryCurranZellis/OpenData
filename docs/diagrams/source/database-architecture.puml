@startuml
!pragma layout smetana
title Database Architecture
skinparam componentStyle rectangle

package "Application" {
  [PluginExecutionCoordinator] as Coordinator
  [OfgemPlugin] as Ofgem
  [OpenMeteoPlugin] as Meteo
}

package "JDBC Infrastructure" {
  [JdbcPluginRunAudit] as Audit
  [SQLServerResource] as Resource
  [Apache DBCP Pool] as Pool
}

database "core schema" as Core
database "ofgem schema" as OfgemSchema
database "openmeteo schema" as MeteoSchema

Coordinator --> Audit
Ofgem --> Resource
Meteo --> Resource
Audit --> Resource
Resource --> Pool
Pool --> Core
Pool --> OfgemSchema
Pool --> MeteoSchema
@enduml
