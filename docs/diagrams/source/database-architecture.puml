@startuml
!pragma layout smetana
title OpenData SQL Server Architecture
skinparam componentStyle rectangle

package "Application Services" {
  [Configuration Registration / JDBC Source] as Config
  [PluginExecutionCoordinator] as Coordinator
  [JdbcPluginRunAudit] as Audit
  [Ofgem Repository] as OfgemRepo
  [OpenMeteo Repository] as MeteoRepo
  [Octopus Repository] as OctopusRepo
}

package "JDBC Infrastructure" {
  [SQLServerResource] as Resource
  [Apache DBCP Pool] as Pool
}

database "core\nconfiguration, PluginRun, provenance" as Core
database "ofgem\nperiods, facts, lineage" as Ofgem
database "openmeteo\nlocations, daily weather" as Meteo
database "octopus\nfile ledger, electricity, gas" as Octopus

Config --> Resource
Coordinator --> Audit
Audit --> Resource
OfgemRepo --> Resource
MeteoRepo --> Resource
OctopusRepo --> Resource
Resource --> Pool
Pool --> Core
Pool --> Ofgem
Pool --> Meteo
Pool --> Octopus
@enduml
