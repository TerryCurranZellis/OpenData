@startuml
!theme plain
title OpenData 4.0.0 startup, initialisation and execution
start
:OpenData.main(args);
:Read bootstrap configuration;
if (init=true?) then (yes)
  if (JavaFX desktop available?) then (yes)
    :Launch OpenDataGuiApplication;
    :Display InitialisationWizard;
    :Validate SQL administrator and application settings;
    :Discover/validate plugin definitions;
    :InitialisationService provisions SQL schema and plugins;
    if (Initialisation successful?) then (yes)
      :Atomically persist encrypted bootstrap;
      :Set init=false;
      :Finish; 
      :Open normal JavaFX main window;
    else (no)
      :Display failure and setup log;
      :Keep init=true for recovery;
      stop
    endif
  else (no)
    :Report GUI required for initialisation;
    stop
  endif
else (no)
  if (No arguments or --gui?) then (yes)
    :GuiLauncher / OpenDataGuiApplication;
    :Show splash screen;
    :Load main FXML, plugin table and status;
    :Operator selects menu or toolbar action;
    if (Execute or dry-run?) then (yes)
      :Confirm selected plugins;
      :PluginExecutionGateway;
      :Show live log and result;
    else (no)
      :Registration, settings, details or help;
    endif
  else (no)
    :Process CLI arguments;
    :OpenDataApplication shared services;
  endif
endif
stop
@enduml
