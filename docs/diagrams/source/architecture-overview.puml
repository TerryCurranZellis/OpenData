@startuml
!pragma layout smetana
title OpenData Architecture Overview
left to right direction
skinparam componentStyle rectangle

actor Operator
component "CLI and Application" as App
component "Plugin Registry and Factory" as Registry
component "Bounded Execution Coordinator" as Coordinator
component "Ofgem Plugin" as Ofgem
component "OpenMeteo Plugin" as Meteo
component "JUL Logging and Audit" as Audit
cloud "Public Data Providers" as Providers
database "SQL Server" as Database

Operator --> App
App --> Registry
App --> Coordinator
Registry --> Coordinator
Coordinator --> Ofgem
Coordinator --> Meteo
Ofgem --> Providers
Meteo --> Providers
Ofgem --> Database
Meteo --> Database
Coordinator --> Audit
Audit --> Database
@enduml
