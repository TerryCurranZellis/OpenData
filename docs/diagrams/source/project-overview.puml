@startuml
!pragma layout smetana
title OpenData 2.0.0 Project Overview
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

actor Operator
component "OpenData CLI\nand Application" as App
component "Bootstrap\nConfiguration" as Bootstrap
component "Database-backed\nConfiguration" as Config
component "Plugin Registry\nand Coordinator" as Framework
component "Ofgem" as Ofgem
component "OpenMeteo" as Meteo
component "Octopus" as Octopus
cloud "Public Data\nProviders" as Public
folder "Customer Statement\nPDFs" as PDFs
database "Microsoft SQL Server" as Db

Operator --> App
App --> Bootstrap
Bootstrap --> Db : decrypt and connect
Db --> Config
Config --> Framework
Framework --> Ofgem
Framework --> Meteo
Framework --> Octopus
Ofgem --> Public
Meteo --> Public
Octopus --> PDFs
Ofgem --> Db
Meteo --> Db
Octopus --> Db
@enduml
