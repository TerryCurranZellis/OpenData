@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam ArrowColor #4A5568
skinparam BorderColor #4A5568
skinparam BackgroundColor white
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #A67C00
title Parallel plugin execution sequence
participant OpenDataApplication as App
participant PluginExecutionCoordinator as Coordinator
participant PluginRunAudit as Audit
participant ReflectionPluginFactory as Factory
participant OpenDataPlugin as Plugin
participant DatabaseResourceManager as Database
App -> Coordinator : execute(resolved plugins, parallelism, dryRun)
loop one task per plugin
  Coordinator -> Factory : create(definition)
  Factory --> Coordinator : fresh plugin instance
  alt normal run
    Coordinator -> Audit : started(runId, pluginId)
  end
  Coordinator -> Plugin : execute(context)
  Plugin -> Database : borrow connection as required
  Database --> Plugin : pooled connection
  Plugin --> Coordinator : PluginMetrics
  alt normal run
    Coordinator -> Audit : completed(result)
  end
end
Coordinator --> App : ordered PluginExecutionSummary
@enduml
