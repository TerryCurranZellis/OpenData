@startuml
!pragma layout smetana
title OpenData Deployment Topology

actor "Operator or External Scheduler" as Operator
node "Execution Host" {
  artifact "OpenData Java 17 classes and dependencies" as Application
  file "External override properties" as Config
  folder "Work and archive" as Files
  folder "JUL logs" as Logs
  component "Apache DBCP pool" as Pool
}

cloud "Public data providers" as Providers
database "SQL Server: OpenData\ncore, ofgem, openmeteo" as Database

Operator --> Application : command-line launch
Application --> Config : read
Application --> Files
Application --> Logs
Application --> Providers : HTTPS
Application --> Pool
Pool --> Database : encrypted JDBC
@enduml
