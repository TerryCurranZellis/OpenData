@startuml
!pragma layout smetana
title OpenMeteo Staged Persistence and Pooled-Session Cleanup

participant OpenMeteoRepository
participant JdbcTransactionTemplate
participant JdbcBatchExecutor
participant SqlIdentifiers
database "SQL Server pooled session" as DB

OpenMeteoRepository -> JdbcTransactionTemplate : execute(work, cleanup)
JdbcTransactionTemplate -> DB : borrow / autoCommit=false
JdbcTransactionTemplate -> OpenMeteoRepository : transaction connection
OpenMeteoRepository -> DB : XACT_ABORT ON + application lock
OpenMeteoRepository -> SqlIdentifiers : qualify(schema, tables)
SqlIdentifiers --> OpenMeteoRepository : safe bracketed names
OpenMeteoRepository -> DB : upsert location + create #OpenMeteoDaily
OpenMeteoRepository -> JdbcBatchExecutor : stage(records, configured size)
JdbcBatchExecutor -> DB : parameterised batches
OpenMeteoRepository -> DB : set-based UPDATE changed
OpenMeteoRepository -> DB : set-based INSERT missing
OpenMeteoRepository --> JdbcTransactionTemplate : counts
JdbcTransactionTemplate -> DB : commit / rollback
JdbcTransactionTemplate -> OpenMeteoRepository : cleanup callback
OpenMeteoRepository -> DB : DROP temp table + XACT_ABORT OFF
JdbcTransactionTemplate -> DB : restore auto-commit / return to pool
@enduml
