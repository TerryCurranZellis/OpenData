@startuml
title OpenMeteo Plugin Pipeline and Persistence
participant OpenMeteoPlugin as Plugin
participant "initialise.OpenMeteoInitialise" as Initialise
participant "extract.OpenMeteoDownloader" as Download
participant "transform.OpenMeteoResponseExtractor" as Extract
participant "transform.validate.OpenMeteoResponseValidator" as Validate
participant "transform.OpenMeteoTransformer" as Transform
participant "load.OpenMeteoRepository" as Load
database "OpenData SQL Server" as SQLServer

Plugin -> Initialise : execute(context)
Initialise -> Download : download(resolved date range)
Download --> Initialise : raw JSON
Initialise -> Extract : parse JSON
Extract --> Initialise : response arrays
Initialise -> Validate : validate aligned daily values
Validate --> Initialise : validated response
Initialise -> Transform : create DailyWeatherRecord values
Transform --> Initialise : records
alt dry run
  Initialise --> Plugin : read/skipped metrics
else write run
  Initialise -> Load : save(configuration, records, runId)
  Load -> SQLServer : BEGIN + location applock
  Load -> SQLServer : upsert Location
  Load -> SQLServer : stage, update, insert daily rows
  Load -> SQLServer : COMMIT and restore session state
  Load --> Initialise : inserted/updated/skipped
  Initialise --> Plugin : metrics
end
@enduml
