@startuml
!pragma layout smetana
title OpenData Version 2.0.0 Component Architecture
skinparam componentStyle rectangle
package "Application" {
  [OpenData] as Entry
  [CommandLineArgumentsProcessor] as CLI
  [OpenDataApplication] as App
}
package "Configuration and Registry" {
  [ApplicationBootstrapPropertiesLoader] as Bootstrap
  [RsaConfigurationPasswordCipher] as Cipher
  [ClasspathPluginRegistry
Registration Catalogue] as Catalogue
  [PropertiesFileConfigurationPropertiesSource] as External
  [ConfigurationRegistrationService] as Register
  [JdbcPluginRegistry] as Registry
  [JdbcConfigurationPropertiesSource] as DbSource
  [PropertiesPluginDefinitionLoader] as Definitions
}
package "Plugin Runtime" {
  [PluginSelectionResolver] as Selection
  [ReflectionPluginFactory] as Factory
  [PluginExecutionCoordinator] as Coordinator
}
package "Provider Plugins" {
  [OfgemPlugin] as Ofgem
  [OpenMeteoPlugin] as Meteo
  [OctopusPlugin] as Octopus
}
package "Infrastructure" {
  [LoggingManager] as Logging
  [JdbcPluginRunAudit] as Audit
  [SQLServerResource / DBCP] as Pool
  database "SQL Server" as Database
  folder "Work / Input / Archive" as Files
}
Entry --> CLI
Entry --> App
App --> Bootstrap
Bootstrap --> Cipher
App --> Catalogue : packaged registration
App --> External : external registration
App --> Register
Register --> Registry
Register --> DbSource
App --> Registry : list/admin/run
App --> Selection
Selection --> Registry
App --> Definitions
App --> Coordinator
Coordinator --> Factory
Factory --> Ofgem
Factory --> Meteo
Factory --> Octopus
Coordinator --> Audit
App --> Logging
Registry --> Pool
DbSource --> Pool
Audit --> Pool
Ofgem --> Pool
Meteo --> Pool
Octopus --> Pool
Ofgem --> Files
Octopus --> Files
Pool --> Database
@enduml
