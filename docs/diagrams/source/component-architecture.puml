@startuml
!pragma layout smetana
title OpenData 4.0.0 — Component Architecture (4.1.0 Launcher Separation)
skinparam componentStyle rectangle
top to bottom direction

package "Launcher / Distribution" {
  [opendata-launcher] as Launcher
  [Six provider implementation JARs] as Providers
}
package "opendata-core" {
  [OpenData entry point] as Main
  [CommandLineArgumentsProcessor] as Cli
  [JavaFX GUI] as Gui
  [InitialisationWizard] as Wizard
  [InitialisationService] as Setup
  [AesConfigurationPasswordCipher] as Cipher
  [JdbcPluginRegistry] as Registry
  [PluginExecutionCoordinator] as Coordinator
  [ReflectionPluginFactory] as Factory
  [SQLServerResource] as Resource
}
package "opendata-api" {
  [OpenDataPlugin / PluginRegistrar] as Contracts
  [DatabaseResourceManager] as DbContract
}
package "opendata-common" {
  [JDBC helpers and provider support] as Support
}
database "SQL Server OpenData" as Sql
folder "config/application.properties" as Config

Launcher --> Main : provides runtime classpath
Launcher --> Providers : provides provider classes/resources
Launcher --> Support : supplies helpers
Main --> Cli
Main --> Gui
Main --> Registry
Main --> Coordinator
Gui --> Wizard : when init=true
Wizard --> Setup : background task
Setup --> Resource : provision schema
Setup --> Cipher : encrypted credentials
Cipher --> Config : key path from properties
Setup --> Registry : register plugins disabled
Coordinator --> Factory : resolve classes from configuration
Factory --> Contracts : instantiate by API interface
Providers --> Contracts : implement
Providers --> Support : reuse
Registry --> Resource
Resource --> DbContract : implement
Resource --> Sql
@enduml
