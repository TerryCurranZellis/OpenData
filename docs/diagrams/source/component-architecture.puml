@startuml
!pragma layout smetana
title OpenData Component Architecture
skinparam componentStyle rectangle

package "Application" {
  [Main] as Main
  [CommandLineArgumentsProcessor] as CLI
  [OpenDataApplication] as AppService
}

package "Plugin Runtime" {
  [ClasspathPluginRegistry] as Registry
  [PropertiesPluginDefinitionLoader] as Definitions
  [ReflectionPluginFactory] as Factory
  [PluginExecutionCoordinator] as Coordinator
}

package "Plugins" {
  [OfgemPlugin] as Ofgem
  [OpenMeteoPlugin] as Meteo
}

package "Infrastructure" {
  [LoggingManager] as Logging
  [JdbcPluginRunAudit] as Audit
  [SQLServerResource] as Pool
  database "SQL Server" as Database
}

Main --> CLI
Main --> AppService
AppService --> Registry
AppService --> Definitions
AppService --> Coordinator
Coordinator --> Factory
Factory --> Ofgem
Factory --> Meteo
AppService --> Logging
Coordinator --> Audit
AppService --> Pool
Audit --> Pool
Ofgem --> Pool
Meteo --> Pool
Pool --> Database
@enduml
