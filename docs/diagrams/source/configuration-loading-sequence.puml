@startuml
title Runtime Registry and Configuration Loading
actor Operator
participant CommandLineArgumentsProcessor as CLI
participant ApplicationBootstrapPropertiesLoader as Bootstrap
participant RsaConfigurationPasswordCipher as Cipher
participant SQLServerResource as SQL
participant JdbcPluginRegistry as Registry
participant JdbcConfigurationPropertiesSource as Properties
participant ApplicationRuntimeConfiguration as Runtime
participant PropertiesPluginDefinitionLoader as Loader

Operator -> CLI : --plugin id|all [--dry-run] [--parallelism n]
CLI --> Bootstrap : validated run request
Bootstrap -> Cipher : decrypt {enc} password
Cipher --> Bootstrap : runtime password
Bootstrap -> SQL : initialise registry/configuration connection
SQL --> Registry : database resource
Registry -> SQL : SELECT core.plugin_registry
Registry --> Runtime : enabled selected descriptors
Properties -> SQL : SELECT application/plugin properties
Properties --> Runtime : runtime values
loop each selected plugin
  Runtime -> Loader : stored plugin properties
  Loader --> Runtime : validated PluginDefinition
end
@enduml
