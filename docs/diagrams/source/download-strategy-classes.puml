@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam ArrowColor #4A5568
skinparam BorderColor #4A5568
skinparam BackgroundColor white
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #A67C00
title Download and discovery classes
interface DataDownloader
class HttpDataDownloader
class HttpDownloadOptions
class DownloadResult
class DirectHttpDownloadStrategy
class HtmlLinkDiscoveryStrategy
interface HtmlLinkDiscoverer
class JsoupHtmlLinkDiscoverer
interface DiscoveredLinkSelector
class HighestScoringLinkSelector
DataDownloader <|.. HttpDataDownloader
HttpDataDownloader --> HttpDownloadOptions
HttpDataDownloader --> DownloadResult
DirectHttpDownloadStrategy --> DataDownloader
HtmlLinkDiscoveryStrategy --> HtmlLinkDiscoverer
HtmlLinkDiscoveryStrategy --> DiscoveredLinkSelector
HtmlLinkDiscoveryStrategy --> DataDownloader
HtmlLinkDiscoverer <|.. JsoupHtmlLinkDiscoverer
DiscoveredLinkSelector <|.. HighestScoringLinkSelector
@enduml
