@startuml
title Ofgem Price-Cap Import
actor Operator
participant OpenDataApplication as Application
participant PluginExecutionCoordinator as Coordinator
participant OfgemPlugin as Plugin
participant OfgemWorkbookDownloader as Downloader
participant OfgemPriceCapWorkbookExtractor as Extractor
participant OfgemWorkbookDataValidator as Validator
participant "load.OfgemPersistenceRepository" as Repository
database "OpenData SQL Server" as Database

Operator -> Application : --plugin ofgem
Application -> Coordinator : execute(resolved plugin)
Coordinator -> Database : INSERT core.PluginRun
Coordinator -> Plugin : execute(context)
Plugin -> Downloader : discover and download workbook
Downloader --> Plugin : ResolvedDownload
Plugin -> Extractor : extract(workbook)
Extractor --> Plugin : period and cap levels
Plugin -> Validator : validate(workbook data)
Validator --> Plugin : validated data
alt dry run
  Plugin --> Coordinator : read/skipped metrics
else write run
  Plugin -> Downloader : optional archive
  Plugin -> Repository : persist(download, workbook data)
  Repository -> Database : BEGIN
  Repository -> Database : ingestion/source provenance
  Repository -> Database : period upsert and fact replacement
  Repository -> Database : COMMIT
  Repository --> Plugin : inserted/updated/skipped
  Plugin --> Coordinator : metrics
  Coordinator -> Database : UPDATE core.PluginRun
end
Coordinator --> Application : summary
@enduml
