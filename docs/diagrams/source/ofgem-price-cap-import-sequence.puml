@startuml
!pragma layout smetana
title Ofgem Price-Cap Import — Shared Processing Infrastructure

actor Operator
participant OfgemPlugin
participant OfgemConfiguration
participant PluginPropertyValues
participant OfgemPersistenceRepository
participant JdbcTransactionTemplate
participant JdbcBatchExecutor
database "SQL Server" as DB

Operator -> OfgemPlugin : --plugin ofgem
OfgemPlugin -> OfgemConfiguration : from(definition)
OfgemConfiguration -> PluginPropertyValues : text/duration/boolean
PluginPropertyValues --> OfgemConfiguration : typed values
OfgemPlugin -> OfgemPersistenceRepository : persist(definition, download, data)
OfgemPersistenceRepository -> JdbcTransactionTemplate : execute(...)
JdbcTransactionTemplate -> DB : borrow connection / begin
JdbcTransactionTemplate -> OfgemPersistenceRepository : transaction connection
OfgemPersistenceRepository -> DB : ingestion + source + period SQL
OfgemPersistenceRepository -> JdbcBatchExecutor : insert levels (batch 500)
JdbcBatchExecutor -> DB : parameterised batches
JdbcBatchExecutor --> OfgemPersistenceRepository : affected count
OfgemPersistenceRepository --> JdbcTransactionTemplate : result
JdbcTransactionTemplate -> DB : commit / rollback
JdbcTransactionTemplate --> OfgemPlugin : persistence result
@enduml
