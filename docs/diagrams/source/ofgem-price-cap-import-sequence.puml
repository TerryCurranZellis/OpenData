@startuml
title Ofgem Price-Cap Import
actor Operator
participant OpenDataApplication as Application
participant PluginExecutionCoordinator as Coordinator
participant OfgemPlugin as Plugin
participant "initialise.OfgemInitialise" as Initialise
participant "extract.OfgemWorkbookDownloader" as Downloader
participant "transform.OfgemPriceCapWorkbookExtractor" as Extractor
participant "transform.validate.OfgemWorkbookDataValidator" as Validator
participant "load.OfgemPersistenceRepository" as Repository
participant "finalise.OfgemFinalise" as Finalise
database "OpenData SQL Server" as Database

Operator -> Application : --plugin ofgem [--dry-run]
Application -> Coordinator : execute(resolved plugin)
Coordinator -> Plugin : execute(context)
Plugin -> Initialise : execute(context)
Initialise -> Downloader : discover and download workbook
Downloader --> Initialise : ResolvedDownload
Initialise -> Extractor : extract(local XLSX)
Extractor --> Initialise : period and cap levels
Initialise -> Validator : validate workbook data
Validator --> Initialise : validated data
alt dry run
  Initialise --> Coordinator : read/skipped metrics
else write run
  Initialise -> Repository : persist(download, data)
  Repository -> Database : BEGIN + provenance + period/facts
  Repository -> Database : COMMIT
  Repository --> Initialise : inserted/updated/skipped
  Initialise -> Finalise : archive successful workbook
  Finalise --> Initialise : complete
  Initialise --> Coordinator : metrics
end
Coordinator --> Application : summary
@enduml
