@startuml
!pragma layout smetana
title Principal Package Dependencies - Version 3.1.0
top to bottom direction

package app
package cli
package gui
package config
package "plugin (shared runtime)" as Plugin

package "plugin.<id> (provider project)" as Provider {
  [workflow facade] as Facade
  [RegisterPlugin] as ProviderRegister
  [initialise / config] as ProviderConfig
  [download] as ProviderDownload
  [extract] as ProviderExtract
  [transform] as ProviderTransform
  [transform.model] as ProviderModel
  [transform.validate] as ProviderValidate
  [load] as ProviderLoad
  [finalise] as ProviderFinalise
}

package discovery
package download
package parser
package validation
package database
package logging
package exception
package util
package "plugin support projects" as ProviderSupport

app --> cli
app --> gui
app --> config
app --> Plugin
app --> database
app --> logging
gui --> app : gateways/services
gui --> config
gui --> Plugin
gui --> logging
Plugin --> config
Plugin --> database
Plugin --> logging
Facade --> Plugin
Facade --> ProviderConfig
Facade --> ProviderFinalise
Plugin --> ProviderRegister : PluginRegistrar on registration
ProviderRegister --> database : creates schema
Facade --> ProviderDownload
Facade --> ProviderExtract
Facade --> ProviderTransform
Facade --> ProviderValidate
Facade --> ProviderLoad
Provider --> ProviderSupport : shared provider code
ProviderDownload --> download
ProviderDownload --> discovery
ProviderExtract --> parser
ProviderTransform --> ProviderModel
ProviderValidate --> ProviderModel
ProviderLoad --> ProviderModel
ProviderLoad --> database
discovery --> exception
download --> exception
parser --> exception
validation --> exception
app --> util
gui --> util
@enduml
