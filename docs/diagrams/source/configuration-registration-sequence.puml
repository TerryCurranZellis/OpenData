@startuml
title Selected Plugin Registration
actor Operator
participant OpenDataApplication as Application
participant ApplicationBootstrapPropertiesLoader as Bootstrap
participant RsaConfigurationPasswordCipher as Cipher
participant ClasspathPluginRegistry as Catalogue
participant PropertiesFileConfigurationPropertiesSource as ExternalFile
participant ConfigurationRegistrationService as Register
participant JdbcPluginRegistry as Registry
participant JdbcConfigurationPropertiesSource as Properties
participant SQLServerResource as SQL

Operator -> Application : --plugin id|all --register [--file complete-plugin.properties]
Application -> Bootstrap : load bootstrap and decrypt password
Bootstrap -> Cipher : decrypt when {enc}
Application -> SQL : initialise connection
alt external file supplied
  Application -> ExternalFile : load exactly one complete named definition
else packaged definition(s)
  Application -> Catalogue : resolve named/repeated/all definitions
end
Application -> Register : register(bootstrap, selected definitions)
Register -> Cipher : encrypt database password
Register -> Properties : save application properties
Properties -> SQL : core.application_property
loop each selected plugin
  Register -> Registry : upsert metadata and replace properties
  Registry -> SQL : core.plugin_registry + core.plugin_property
end
Register -> Bootstrap : store encrypted bootstrap and database mode=true
@enduml
