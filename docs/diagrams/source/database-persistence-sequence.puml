@startuml
title Borrow, use and return a pooled SQL Server connection
actor "Repository" as repo
participant SQLServerResource as resource
participant "DBCP PoolingDriver" as driver
participant GenericObjectPool as pool
database "SQL Server" as sql

repo -> resource : getConnection()
resource -> driver : DriverManager.getConnection(pool URL)
driver -> pool : borrowObject()
pool -> sql : validate/borrow physical session
sql --> pool : session ready
pool --> driver : pooled Connection
driver --> resource : logical Connection
resource --> repo : Connection
repo -> sql : prepared statements / transaction
sql --> repo : results
repo -> pool : Connection.close()
note right of pool
close returns the logical connection
to the pool; it does not normally
close the physical SQL session.
end note
@enduml
