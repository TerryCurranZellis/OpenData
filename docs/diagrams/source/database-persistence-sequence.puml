@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam ArrowColor #4A5568
skinparam BorderColor #4A5568
skinparam BackgroundColor white
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #A67C00
title Repository transaction and pool sequence
participant Plugin
participant Repository
participant DatabaseResourceManager as Pool
database "SQL Server" as SQL
Plugin -> Repository : persist(records)
Repository -> Pool : getConnection()
Pool -> SQL : borrow physical session
SQL --> Repository : logical Connection
Repository -> SQL : setAutoCommit(false)
Repository -> SQL : prepared statements / batches
alt success
  Repository -> SQL : commit
else failure
  Repository -> SQL : rollback
end
Repository -> Pool : Connection.close()
Pool --> Repository : session returned
Repository --> Plugin : persistence metrics or exception
@enduml
