@startuml
title OpenData Command-Line Flow
start
:Parse and validate arguments;
if (Help or About?) then (yes)
  :Display information without SQL Server;
elseif (List plugins?) then (yes)
  :Open bootstrap SQL connection;
  :Read core.plugin_registry;
  :Display registered status;
elseif (Administration command?) then (yes)
  :Require plugin id(s) or all;
  :Open bootstrap SQL connection;
  if (Register?) then (yes)
    :Load packaged definitions or one external file;
    :Persist registry and properties;
  else (no)
    :Unregister, enable or disable selected registry rows;
  endif
else (run)
  :Open SQL Server for registry/configuration;
  :Resolve enabled registered plugins;
  if (Dry run?) then (yes)
    :Use no-op audit and unavailable plugin data resource;
  else (no)
    :Initialise write pool and JDBC audit;
  endif
  :Execute with bounded parallelism;
  :Log ordered summaries;
endif
:Log final status and duration;
stop
@enduml
