@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam ArrowColor #4A5568
skinparam BorderColor #4A5568
skinparam BackgroundColor white
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #A67C00
title Dataset execution lifecycle
[*] --> Selected
Selected --> Configured : resolve definition and overrides
Configured --> Running : submit plugin task
Running --> Downloaded : source acquired
Downloaded --> Parsed : response parsed
Parsed --> Validated : validation passes
Validated --> Persisted : normal run
Validated --> DryRunComplete : dry run
Persisted --> Successful
DryRunComplete --> Successful
Running --> Failed : exception
Downloaded --> Failed : exception
Parsed --> Failed : validation or parsing failure
Persisted --> Failed : transaction failure
Running --> Cancelled : interruption
Failed --> [*]
Cancelled --> [*]
Successful --> [*]
@enduml
