@startuml
!pragma layout smetana
title Plugin Task Lifecycle
[*] --> CONFIGURED
CONFIGURED --> RUNNING
RUNNING --> ACQUIRED
ACQUIRED --> PARSED
PARSED --> DRY_RUN_COMPLETE : dry run
PARSED --> PERSISTING : write run
PERSISTING --> SUCCESS
CONFIGURED --> FAILED
RUNNING --> FAILED
ACQUIRED --> FAILED
PARSED --> FAILED
PERSISTING --> FAILED
RUNNING --> CANCELLED
ACQUIRED --> CANCELLED
PARSED --> CANCELLED
PERSISTING --> CANCELLED
DRY_RUN_COMPLETE --> [*]
SUCCESS --> [*]
FAILED --> [*]
CANCELLED --> [*]
@enduml
