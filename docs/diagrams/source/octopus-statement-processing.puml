@startuml
!pragma layout smetana
title Octopus Statement Processing — Generic Typed Upserts

actor Operator
participant OctopusPlugin
participant OctopusConfiguration
participant PluginPropertyValues
participant OctopusPersistenceRepository
participant JdbcTransactionTemplate
participant JdbcUpsertExecutor
participant ElectricityRecordUpsertAdapter
participant GasRecordUpsertAdapter
database "SQL Server" as DB

Operator -> OctopusPlugin : --plugin octopus
OctopusPlugin -> OctopusConfiguration : from(definition)
OctopusConfiguration -> PluginPropertyValues : requiredPath x3
OctopusPlugin -> OctopusPersistenceRepository : save(parseResult, runId)
OctopusPersistenceRepository -> JdbcTransactionTemplate : execute(...)
JdbcTransactionTemplate -> DB : begin transaction
OctopusPersistenceRepository -> JdbcUpsertExecutor : electricity records
JdbcUpsertExecutor -> ElectricityRecordUpsertAdapter : exists / insert / update
ElectricityRecordUpsertAdapter -> DB : electricity SQL
OctopusPersistenceRepository -> JdbcUpsertExecutor : gas records
JdbcUpsertExecutor -> GasRecordUpsertAdapter : exists / insert / update
GasRecordUpsertAdapter -> DB : gas SQL
OctopusPersistenceRepository -> DB : MERGE statement_file COMPLETED
OctopusPersistenceRepository --> JdbcTransactionTemplate : combined counts
JdbcTransactionTemplate -> DB : commit / rollback
JdbcTransactionTemplate --> OctopusPlugin : result
@enduml
