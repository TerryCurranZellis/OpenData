@startuml
title Octopus Energy Statement Processing
actor Operator
participant OctopusPlugin as Plugin
participant "initialise.OctopusInitialise" as Initialise
participant "extract.OctopusExtract" as Extract
participant "OctopusProcessedFileRepository" as LedgerRead
participant PdfTextExtractor as Pdf
participant "transform.OctopusStatementParser" as Parser
participant "load.OctopusPersistenceRepository" as Repository
participant "finalise.OctopusFinalise" as Finalise
database "OpenData SQL Server" as Database
folder "Input PDFs" as Input
folder "Archive" as Archive

Operator -> Plugin : --plugin octopus
Plugin -> Initialise : execute(context)
Initialise -> Extract : extract(configuration, context)
Extract -> Input : list matching filename pattern
Extract -> LedgerRead : find completed filename+hash keys
LedgerRead -> Database : SELECT octopus.statement_file
LedgerRead --> Extract : completed keys
loop each new or changed PDF
  Extract -> Pdf : extract text + SHA-256 metadata
  Pdf --> Extract : ExtractedOctopusStatement
end
Extract --> Initialise : statements
Initialise -> Parser : parse electricity and gas
Parser --> Initialise : typed records
alt dry run (current defect)
  note over Extract,Database
    Framework database is unavailable during plugin dry run,
    so the ledger read fails before this point.
  end note
else write run
  Initialise -> Repository : save complete batch
  Repository -> Database : BEGIN
  Repository -> Database : insert/update facts + mark files COMPLETED
  Repository -> Database : COMMIT
  Repository --> Initialise : metrics
  Initialise -> Finalise : finalise(completed=true)
  Finalise -> Input : move successful PDFs
  Finalise -> Archive : replace/move by filename
end
@enduml
