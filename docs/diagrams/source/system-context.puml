@startuml
!pragma layout smetana
title OpenData System Context
left to right direction
actor Operator
rectangle "OpenData Java Application" as App
file "External Override File" as Config
cloud "Ofgem and Open-Meteo" as Publishers
database "SQL Server" as Database
folder "Work, Archive and Logs" as Files

Operator --> App : command
App --> Config : read
App --> Publishers : HTTPS
App --> Database : pooled JDBC
App --> Files : read and write
@enduml
