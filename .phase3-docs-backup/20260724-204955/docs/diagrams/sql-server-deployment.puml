@startuml
title OpenData deployment topology
node "Execution host" {
  artifact "OpenData Java 17 JAR" as app
  folder "External configuration" as config
  folder "Staging / archive" as files
  folder "Application logs" as logs
  component "Apache DBCP pool" as pool
  app --> config
  app --> files
  app --> logs
  app --> pool
}
cloud "Public data publishers" as internet
database "SQL Server\nDatabase: OpenData" as sql
actor "External scheduler / operator" as scheduler

scheduler --> app : command-line invocation
app --> internet : HTTPS discovery/download
pool --> sql : encrypted JDBC
note right of sql
Login/user: OpenData
Role: opendata_app
Schemas: core, ofgem
end note
@enduml
